{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadmap Studio",
  "version": "0.1.12",
  "identifier": "com.roadmapstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Roadmap Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "msi",
    "category": "Productivity",
    "shortDescription": "Professional roadmap planning.",
    "longDescription": "Roadmap Studio is a local-first desktop application for managing roadmaps, phases, tasks, notes, and future sync-ready planning data.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QUQyRDgzOThCRUVEMTgKUldRWTdiNllneTJ0bUs5RlRTenNQbHJDUHdzK3pQMkNUNENnNC9idThJNnBGQzk5bDFacWJsSzgK",
      "windows": {
        "installMode": "basicUi"
      },
      "endpoints": [
        "https://github.com/ithalov/roadmap-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
